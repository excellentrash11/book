# Copy this file to .env and fill in your API keys

# Required: Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Alpha Vantage for additional market data (free tier)
# Get key from https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Timezone for scheduling (default: America/Los_Angeles)
TIMEZONE=America/Los_Angeles

# Digest time (24-hour format, default: 14:00 for 2pm)
DIGEST_TIME=14:00
